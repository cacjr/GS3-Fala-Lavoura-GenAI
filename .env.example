# Copie este arquivo para .env e coloque sua chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=cole_sua_chave_aqui

# Modelos (confira no AI Studio quais o seu plano oferece)
MODELO_CHAT=gemini-3.6-flash
MODELO_FISCAL=gemini-3.5-flash-lite
MODELO_RESERVA=gemini-3.1-flash-lite
MODELO_JUIZ=gemma-4-26b-a4b-it
MODELO_EMBEDDING=gemini-embedding-001

# Plano gratuito: cerca de 20 requisições POR DIA para cada modelo. Cada pergunta gasta ~2 no chat + 1 no fiscal.
# Limite de requisições por minuto
REQUISICOES_POR_MINUTO=8
